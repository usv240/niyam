[Unit]
Description=Niyam API
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/niyam/agent
EnvironmentFile=/etc/niyam/env
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/niyam/agent/.venv/bin/uvicorn niyam.api:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
