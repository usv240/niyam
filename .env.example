# Copy to ../.env (workspace root) or ./.env and fill in. Never commit real values.
ANTHROPIC_API_KEY=
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
# Defaults chosen by measurement (evals v1 to v3): cheaper models only where quality held at 100%.
ANTHROPIC_MODEL=claude-sonnet-5-5         # extraction (Haiku missed a real change here: keep Sonnet)
ANTHROPIC_MODEL_ENCODE=claude-haiku-5-5   # coding agent
ANTHROPIC_MODEL_FAST=claude-haiku-5-5     # triage
ANTHROPIC_MODEL_VERIFY=claude-sonnet-5-5  # verifier and coordinator
# Where the local clone of the rulebook lives, and where it is published
NIYAM_RULEBOOK_PATH=../niyam-rulebook
NIYAM_RULEBOOK_REPO=usv240/niyam-rulebook
# github: push branches and open pull requests. local: keep branches local only.
NIYAM_PUBLISH_MODE=github
# Comma separated failures to inject for demos: source_timeout,ocr,invalid_json
NIYAM_CHAOS=
# Secret used to hash API keys
NIYAM_KEY_SECRET=
